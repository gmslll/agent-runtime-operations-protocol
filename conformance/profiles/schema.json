{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/conformance/profiles/schema.json",
  "title": "AROP portable conformance profile catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "includes", "scenarios"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "includes": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 64}},
          "scenarios": {
            "type": "array", "maxItems": 256,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "required"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128},
                "required": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
