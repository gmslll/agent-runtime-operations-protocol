{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/conformance/codegen-spike.schema.json",
  "title": "AROP code generation representative spike",
  "type": "object",
  "required": ["schema_version", "payload", "occurred_at", "labels", "attributes", "extension", "tree", "safe_integer"],
  "properties": {
    "schema_version": {"const": 1},
    "payload": {
      "oneOf": [
        {"$ref": "#/$defs/textPayload"},
        {"$ref": "#/$defs/jsonPayload"}
      ]
    },
    "optional_nullable": {
      "anyOf": [
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "attributes": {"type": "object", "additionalProperties": true},
    "extension": {"$ref": "https://arop.invalid/conformance/extension-envelope.schema.json"},
    "tree": {"$ref": "#/$defs/node"},
    "safe_integer": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991}
  },
  "additionalProperties": false,
  "$defs": {
    "textPayload": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string"}
      },
      "additionalProperties": false
    },
    "jsonPayload": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "json"},
        "value": true
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["name", "children"],
      "properties": {
        "name": {"type": "string"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/node"}
        }
      },
      "additionalProperties": false
    }
  }
}
