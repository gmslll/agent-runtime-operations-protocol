      "path": "/v1/agent-definitions/{agent_id}/versions/{version}",
      "required_headers": [
        "Authorization"
      ],
      "request_media_types": [],
      "success": {
        "status": 200,
        "body_schema": "AgentManifest",
        "response_media_type": "application/json",
        "required_headers": [
          "ETag"
        ],
        "etag_strength": "strong",
        "etag_matches_publication": true,
        "etag_semantic_digest_source": "validated-semantic-manifest-document"
      },
      "required_scopes": [
        "agent:read"
      ],
      "scope_extension": "x-arop-required-scopes"
    },
    {
      "operation_id": "publishAgentVersion",
      "method": "POST",
      "path": "/v1/agent-definitions/{agent_id}/versions",
      "required_headers": [
        "Authorization",
        "Content-Type",
        "Idempotency-Key"
      ],
      "request_media_types": [
        "application/vnd.arop.agent-version-bundle+zip"
      ],
      "success": {
        "status": 201,
        "body_schema": null,
        "response_media_type": null,
        "required_headers": [
          "ETag",
          "Location"
        ],
        "etag_strength": "strong",
        "etag_semantic_digest_source": "validated-semantic-manifest-document",
        "location_template": "/v1/agent-definitions/{agent_id}/versions/{version}"
      },
      "required_scopes": [
        "agent:publish"
      ],
      "scope_extension": "x-arop-required-scopes"
    }
  ],
