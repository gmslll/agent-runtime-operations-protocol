{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/trusted-key-registry.schema.json",
  "title": "External trusted-key registry consumed by P03/P04",
  "type": "object",
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key_id", "algorithm", "role", "public_key_pem"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "algorithm": {"const": "Ed25519"},
          "role": {"enum": ["independent_reviewer", "project_owner", "release_approver"]},
          "public_key_pem": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
