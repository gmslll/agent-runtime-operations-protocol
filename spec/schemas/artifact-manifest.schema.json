{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/artifact-manifest.schema.json",
  "title": "AROP planning artifact catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "updated", "purpose", "authority_chain", "statuses", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"const": "arop-artifact-catalog-v1"},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "purpose": {"type": "string", "minLength": 1},
    "authority_chain": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["rank", "role", "sources", "rule"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "sources": {"$ref": "#/$defs/idList"},
          "rule": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "statuses": {
      "type": "object",
      "required": ["present", "planned"],
      "properties": {
        "present": {"type": "string", "minLength": 1},
        "planned": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "status", "kind", "authority", "derives_from"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "status": {"enum": ["present", "planned"]},
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "authority": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "language": {"enum": ["go", "python", "typescript", "language-neutral"]},
          "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "owner_phase": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"},
          "completion_phase": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"},
          "producer_phase": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"},
          "future_action": {"enum": ["migrate-retire", "repair-retain", "extend-retain"]},
          "future_owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "future_owner_phase": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"},
          "future_acceptance_test": {"type": "string", "pattern": "^make-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "future_artifacts": {"$ref": "#/$defs/idList"},
          "path_role": {"enum": ["concrete", "aggregate", "container"]},
          "acceptance_test": {"type": "string", "pattern": "^make-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "exposure": {"enum": ["public-contract", "reference-only", "repository-internal"]},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
          },
          "derives_from": {"$ref": "#/$defs/idList"},
          "runtime_inputs": {"$ref": "#/$defs/idList"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "planned"}}, "required": ["status"]},
            "then": {
              "oneOf": [
                {"properties": {"owner_phase": {}}, "required": ["owner_phase"]},
                {"properties": {"completion_phase": {}}, "required": ["completion_phase"]},
                {"properties": {"producer_phase": {}}, "required": ["producer_phase"]}
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "additionalProperties": false
}
