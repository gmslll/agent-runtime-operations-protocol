{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/check-report.schema.json",
  "title": "AROP machine check report",
  "type": "object",
  "required": ["schema_version", "generated_at", "success", "provenance", "summary", "checks", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "success": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "required": ["git", "command", "runtime", "checker", "inputs", "runtime_inputs", "runtime_evidence", "testcase_count", "audit_note"],
      "properties": {
        "git": {
          "type": "object",
          "required": ["head", "dirty", "dirty_entries"],
          "properties": {
            "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dirty": {"type": "boolean"},
            "dirty_entries": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "command": {"type": "string", "minLength": 1},
        "runtime": {
          "type": "object",
          "required": ["node", "go", "os"],
          "properties": {
            "node": {"type": "string", "minLength": 1},
            "go": {"type": "string", "minLength": 1},
            "os": {
              "type": "object",
              "required": ["platform", "release", "arch"],
              "properties": {
                "platform": {"type": "string", "minLength": 1},
                "release": {"type": "string", "minLength": 1},
                "arch": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "checker": {"$ref": "#/$defs/digested_file"},
        "inputs": {
          "type": "object",
          "required": ["sha256", "files"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/input_file"}
            }
          },
          "additionalProperties": false
        },
        "runtime_inputs": {
          "type": "object",
          "required": ["sha256", "files"],
          "properties": {
            "sha256": {"$ref": "#/$defs/sha256"},
            "files": {
              "type": "array",
              "items": {"$ref": "#/$defs/input_file"}
            }
          },
          "additionalProperties": false
        },
        "runtime_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/runtime_evidence"}
        },
        "controlled_inputs": {"$ref": "#/$defs/controlled_inputs"},
        "testcase_count": {"type": "integer", "minimum": 1},
        "audit_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["checks", "passed", "failed", "testcase_count"],
      "properties": {
        "checks": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "testcase_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digested_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "input_file": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "runtime_evidence": {
      "type": "object",
      "required": ["kind", "sha256", "bytes"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "controlled_inputs": {
      "type": "object",
      "required": ["policy", "scope", "source", "tree", "sha256", "entries"],
      "properties": {
        "policy": {"const": "tracked-repository-tree-v1"},
        "scope": {"enum": ["P01", "P02"]},
        "source": {"const": "current-index-worktree"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["path", "type", "mode", "link_target", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "type": {"const": "blob"},
              "mode": {"enum": ["100644", "100755"]},
              "link_target": {"const": ""},
              "sha256": {"$ref": "#/$defs/sha256"},
              "bytes": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
