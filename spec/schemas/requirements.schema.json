{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/requirements.schema.json",
  "title": "AROP immutable requirements traceability",
  "type": "object",
  "required": ["schema_version", "updated", "source", "immutability_rule", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {"const": "epic-immutable-requirements"},
    "immutability_rule": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "required": ["id", "statement", "artifacts", "phases", "tests"],
        "properties": {
          "id": {"type": "string", "pattern": "^IR-(?:0[1-9]|1[0-4])$"},
          "statement": {"type": "string", "minLength": 1},
          "artifacts": {"$ref": "#/$defs/nonEmptyIDs"},
          "phases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"}
          },
          "tests": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^make-[a-z0-9]+(?:-[a-z0-9]+)*$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "nonEmptyIDs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    }
  },
  "additionalProperties": false
}
