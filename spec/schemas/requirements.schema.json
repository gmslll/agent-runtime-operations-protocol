{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/requirements.schema.json",
  "title": "AROP immutable requirements traceability",
  "type": "object",
  "required": ["schema_version", "updated", "source", "immutability_rule", "statements_digest_algorithm", "statements_digest", "requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source": {"const": "epic-immutable-requirements"},
    "immutability_rule": {"type": "string", "minLength": 1},
    "statements_digest_algorithm": {"const": "sha256-jcs"},
    "statements_digest": {"const": "sha256:ae16611e5286beaf050f505dd603f3bc761a96bf03d4c145a27d14d69c89d8fd"},
    "requirements": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-01"}, "statement_original_zh": {"const": "先把全量实现规划落到仓库权威文档；之后实现必须按核心文档推进。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-02"}, "statement_original_zh": {"const": "协议仓保持厂商中立，不依赖 Console、飞书、cc-connect 或具体 Agent 框架；不得修改 `kinglucky-agent-console`。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-03"}, "statement_original_zh": {"const": "后端采用 Go：Reference Control Plane、Registry、Dispatcher、Run/Event Ledger、服务端 Conformance/故障驱动；Node 仅用于 Schema/TS 工具，Python 做 Provider SDK，TypeScript 做 Consumer SDK。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-04"}, "statement_original_zh": {"const": "覆盖发布、注册、发现、鉴权、Run/Attempt、Direct/Proxy/Worker Pull、结构化流式、结果、usage、审计、trace、drain/升级全生命周期。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-05"}, "statement_original_zh": {"const": "所有新调用先经 Control Plane 鉴权并创建 Run；可信服务拿 Dispatch Ticket 后可 Direct；浏览器 v1 走 BFF/Proxy。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-06"}, "statement_original_zh": {"const": "自研 Registry，借鉴 Lease/Revision/Watch/CAS/Fencing，不依赖 etcd/Nacos。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-07"}, "statement_original_zh": {"const": "交付语义为 at-least-once，包含幂等、durable inbox/outbox、`effect_id`、终态不可变、final Snapshot。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-08"}, "statement_original_zh": {"const": "SDK 放协议仓；Quickstart/Conformance 不依赖 Console 可独立运行。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-09"}, "statement_original_zh": {"const": "Core/Profile/Extension 分层；兼容 A2A/MCP/ARD/CloudEvents/OpenTelemetry。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-10"}, "statement_original_zh": {"const": "SQLite Quickstart 与 PostgreSQL production reference 语义一致。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-11"}, "statement_original_zh": {"const": "最终目录必须清晰分离手写源码、生成代码、公共 SDK、Go 内部后端、迁移、参考实现、conformance、部署与 CI。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-12"}, "statement_original_zh": {"const": "对外发布受 domain/package ownership、双 maintainer/security 入口等外部条件门控。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-13"}, "statement_original_zh": {"const": "全部验收机器可测，覆盖跨语言、故障注入、HA、replay/out-of-order/cancel/fencing。"}}}]},
        {"allOf": [{"$ref": "#/$defs/requirement"}, {"type": "object", "properties": {"id": {"const": "IR-14"}, "statement_original_zh": {"const": "不得把外部合作伙伴/独立实现等外部条件伪造为完成。"}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "statement_original_zh", "translation_en", "artifacts", "phases", "tests"],
      "properties": {
        "id": {"type": "string", "pattern": "^IR-(?:0[1-9]|1[0-4])$"},
        "statement_original_zh": {"type": "string", "minLength": 1},
        "translation_en": {"type": "string", "minLength": 1},
        "artifacts": {"$ref": "#/$defs/nonEmptyIDs"},
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"}
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^make-[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      },
      "additionalProperties": false
    },
    "nonEmptyIDs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    }
  },
  "additionalProperties": false
}
