{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/conflicts.schema.json",
  "title": "AROP resolved conflict ledger",
  "type": "object",
  "required": ["schema_version", "updated", "closure_rule", "verification_catalog", "conflicts"],
  "properties": {
    "schema_version": {"const": 1},
    "updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "closure_rule": {"type": "string", "minLength": 1},
    "verification_catalog": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {
        "type": "object",
        "required": ["status", "owner_artifact"],
        "properties": {
          "status": {"enum": ["present", "planned"]},
          "owner_artifact": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "implementation_state", "decisions", "resolution", "repair_locations", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^CF-[0-9]{3}$"},
          "title": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"const": "resolved"},
          "implementation_state": {"type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$"},
          "decisions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^D-[0-9]{3}$"}
          },
          "resolution": {"type": "string", "minLength": 1},
          "repair_locations": {"$ref": "#/$defs/nonEmptyIDs"},
          "verification": {"$ref": "#/$defs/nonEmptyIDs"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "nonEmptyIDs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    }
  },
  "additionalProperties": false
}
