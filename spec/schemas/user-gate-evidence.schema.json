{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/spec/schemas/user-gate-evidence.schema.json",
  "title": "External P04 user approval evidence",
  "type": "object",
  "required": ["schema_version", "kind", "gate", "subject", "approval", "approved_at", "signed_summary"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "arop-user-gate"},
    "gate": {"const": "P04"},
    "subject": {
      "type": "object",
      "required": ["commit", "plan_last_phase", "plan_sha256", "blueprint_sha256", "planning_audit_report_sha256"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "plan_last_phase": {"$ref": "#/$defs/phase_id"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "blueprint_sha256": {"$ref": "#/$defs/sha256"},
        "planning_audit_report_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["approver_id", "approved"],
      "properties": {
        "approver_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "approved": {"const": true}
      },
      "additionalProperties": false
    },
    "approved_at": {"type": "string", "format": "date-time"},
    "signed_summary": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "phase_id": {"type": "string", "pattern": "^P(?:0[1-9]|[1-9][0-9])$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
