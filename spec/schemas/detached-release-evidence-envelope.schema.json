{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.dev/schemas/detached-release-evidence-envelope-v1.schema.json",
  "title": "AROP detached release evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_uri", "object_format", "subject", "kind", "schema_sha256", "policy_sha256", "validator_sha256", "issued_at", "expires_at", "principal_id", "role", "trust", "payload", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "repository_uri": {"const": "https://github.com/gmslll/agent-runtime-operations-protocol"},
    "object_format": {"const": "git-sha1"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "kind": {"enum": ["external_config", "external_conformance", "final_equivalence", "final_delivery"]},
    "schema_sha256": {"$ref": "#/$defs/digest"}, "policy_sha256": {"$ref": "#/$defs/digest"}, "validator_sha256": {"$ref": "#/$defs/digest"},
    "issued_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"},
    "principal_id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"},
    "trust": {"type": "object", "additionalProperties": false, "required": ["root_sha256", "registry_sha256", "checkpoint_version", "checkpoint_sha256"], "properties": {"root_sha256": {"$ref": "#/$defs/digest"}, "registry_sha256": {"$ref": "#/$defs/digest"}, "checkpoint_version": {"type": "integer", "minimum": 1}, "checkpoint_sha256": {"$ref": "#/$defs/digest"}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["media_type", "sha256", "bytes"], "properties": {"media_type": {"enum": ["application/json", "application/vnd.dsse.envelope.v1+json"]}, "sha256": {"$ref": "#/$defs/digest"}, "bytes": {"type": "integer", "minimum": 1}}},
    "verification": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["method", "signatures"], "properties": {"method": {"const": "ed25519"}, "signatures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signature"}}}},
        {"type": "object", "additionalProperties": false, "required": ["method", "payload_type", "signature", "certificate_chain_pem", "identity", "rekor"], "properties": {"method": {"const": "dsse-sigstore"}, "payload_type": {"const": "application/vnd.arop.release-evidence.v1+json"}, "signature": {"type": "string", "minLength": 88, "maxLength": 88}, "certificate_chain_pem": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^-----BEGIN CERTIFICATE-----"}}, "identity": {"$ref": "#/$defs/identity"}, "rekor": {"$ref": "#/$defs/rekor"}}}
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "signature": {"type": "object", "additionalProperties": false, "required": ["key_id", "signature"], "properties": {"key_id": {"$ref": "#/$defs/id"}, "signature": {"type": "string", "minLength": 88, "maxLength": 88}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["principal_id", "role", "issuer", "subject", "repository", "workflow_ref", "workflow_sha", "event"], "properties": {"principal_id": {"$ref": "#/$defs/id"}, "role": {"$ref": "#/$defs/id"}, "issuer": {"type": "string", "minLength": 1}, "subject": {"type": "string", "format": "uri"}, "repository": {"const": "gmslll/agent-runtime-operations-protocol"}, "workflow_ref": {"type": "string", "minLength": 1}, "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "event": {"const": "workflow_dispatch"}}},
    "rekor": {"type": "object", "additionalProperties": false, "required": ["log_id", "log_index", "integrated_time", "body_sha256", "tree_size", "root_hash", "hashes", "checkpoint_signature"], "properties": {"log_id": {"$ref": "#/$defs/id"}, "log_index": {"type": "integer", "minimum": 0}, "integrated_time": {"type": "integer", "minimum": 1}, "body_sha256": {"$ref": "#/$defs/digest"}, "tree_size": {"type": "integer", "minimum": 1}, "root_hash": {"$ref": "#/$defs/digest"}, "hashes": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/digest"}}, "checkpoint_signature": {"type": "string", "minLength": 88, "maxLength": 88}}}
  }
}
