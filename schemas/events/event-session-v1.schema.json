{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/events/event-session-v1.schema.json",
  "title": "AROP v1 event session and batch models",
  "$defs": {
    "positiveSafeInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "eventSessionRequest": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "deployment_id", "generation", "fencing_token"], "properties": {"attempt_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/attemptId"}, "deployment_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/deploymentId"}, "generation": {"$ref": "#/$defs/positiveSafeInteger"}, "fencing_token": {"$ref": "#/$defs/positiveSafeInteger"}}},
    "eventSession": {"type": "object", "additionalProperties": false, "required": ["event_batch_url", "event_token", "expires_at", "max_batch_events", "max_batch_bytes"], "properties": {"event_batch_url": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+/v1/agent-runs/run_[0-9a-f-]+/events:batch$", "maxLength": 2048}, "event_token": {"type": "string", "pattern": "^evtcap_[A-Za-z0-9_-]{43,171}$", "maxLength": 178}, "expires_at": {"type": "string", "format": "date-time"}, "max_batch_events": {"const": 100}, "max_batch_bytes": {"const": 262144}}},
    "eventBatch": {"type": "object", "additionalProperties": false, "required": ["batch_id", "attempt_id", "fencing_token", "events"], "properties": {"batch_id": {"type": "string", "pattern": "^batch_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}, "attempt_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/attemptId"}, "fencing_token": {"$ref": "#/$defs/positiveSafeInteger"}, "events": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "https://arop.invalid/schemas/v1/events/event-envelope-v1.schema.json"}}}},
    "eventBatchAck": {"type": "object", "additionalProperties": false, "required": ["accepted_through_producer_sequence", "assigned_run_sequence", "duplicate_event_ids", "run_state"], "properties": {"accepted_through_producer_sequence": {"$ref": "#/$defs/positiveSafeInteger"}, "assigned_run_sequence": {"$ref": "#/$defs/positiveSafeInteger"}, "duplicate_event_ids": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/eventId"}}, "run_state": {"enum": ["dispatching", "running", "waiting_input", "cancel_requested", "succeeded", "failed", "cancelled", "timed_out"]}}}
  },
  "oneOf": [{"$ref": "#/$defs/eventSessionRequest"}, {"$ref": "#/$defs/eventSession"}, {"$ref": "#/$defs/eventBatch"}, {"$ref": "#/$defs/eventBatchAck"}]
}
