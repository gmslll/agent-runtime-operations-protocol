{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/events/lifecycle-events-v1.schema.json",
  "title": "AROP v1 lifecycle event data",
  "oneOf": [
    {"$ref": "#/$defs/stateData"},
    {"$ref": "#/$defs/terminalData"}
  ],
  "$defs": {
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "duration_ms"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "billable_units": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "stateData": {
      "type": "object", "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"enum": ["accepted", "started", "waiting_input", "cancel_requested"]}}
    },
    "terminalData": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "usage", "completed_at"],
      "properties": {
        "state": {"enum": ["succeeded", "failed", "cancelled", "timed_out"]},
        "snapshot": {"$ref": "https://arop.invalid/schemas/v1/runtime/result-v1.schema.json#/$defs/snapshot"},
        "result_ref": {"$ref": "https://arop.invalid/schemas/v1/resources/data-ref-v1.schema.json"},
        "error": {"$ref": "https://arop.invalid/schemas/v1/common/error.schema.json"},
        "usage": {"$ref": "#/$defs/usage"},
        "completed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "succeeded"}}, "required": ["state"]}, "then": {"oneOf": [{"required": ["snapshot"], "not": {"required": ["result_ref"]}}, {"required": ["result_ref"], "not": {"required": ["snapshot"]}}], "not": {"required": ["error"]}}},
        {"if": {"properties": {"state": {"const": "failed"}}, "required": ["state"]}, "then": {"required": ["error"], "not": {"anyOf": [{"required": ["snapshot"]}, {"required": ["result_ref"]}]}}},
        {"if": {"properties": {"state": {"enum": ["cancelled", "timed_out"]}}, "required": ["state"]}, "then": {"not": {"anyOf": [{"required": ["snapshot"]}, {"required": ["result_ref"]}]}}}
      ]
    }
  }
}
