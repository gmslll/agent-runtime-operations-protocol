{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/runtime/worker-complete-v1.schema.json",
  "title": "AROP v1 Worker completion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "completion_id", "claim_id", "attempt_id", "fencing_token", "lease_token", "result", "completed_at"],
  "properties": {
    "schema_version": {"const": 1},
    "completion_id": {"type": "string", "pattern": "^cmp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "claim_id": {"$ref": "https://arop.invalid/schemas/v1/runtime/worker-claim-v1.schema.json#/$defs/claimId"},
    "attempt_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/attemptId"},
    "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "lease_token": {"$ref": "https://arop.invalid/schemas/v1/runtime/worker-claim-v1.schema.json#/$defs/leaseToken"},
    "result": {"$ref": "https://arop.invalid/schemas/v1/runtime/result-v1.schema.json"},
    "effect_ids": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/effectId"}},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
