{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/runtime/attempt-v1.schema.json",
  "title": "AROP v1 execution attempt",
  "$comment": "A durable, monotonically fenced execution attempt. Numbers crossing the wire are bounded to the JavaScript safe-integer range.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "attempt_number", "deployment_id", "instance_id", "session_id", "generation", "fencing_token", "state", "transport_profile", "endpoint", "audience", "lease_expires_at", "created_at", "traceparent"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/runId"},
    "attempt_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/attemptId"},
    "attempt_number": {"$ref": "#/$defs/positiveSafeInteger"},
    "deployment_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/deploymentId"},
    "instance_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/instanceId"},
    "session_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/sessionId"},
    "generation": {"$ref": "#/$defs/positiveSafeInteger"},
    "fencing_token": {"$ref": "#/$defs/positiveSafeInteger"},
    "state": {"enum": ["issued", "accepted", "failed", "expired", "fenced", "cancelled"]},
    "transport_profile": {"enum": ["direct", "proxy", "worker_pull"]},
    "endpoint": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$", "maxLength": 2048},
    "audience": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$", "maxLength": 2048},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": "string", "format": "date-time"},
    "failure_code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"},
    "traceparent": {"$ref": "https://arop.invalid/schemas/v1/common/trace.schema.json#/properties/traceparent"}
  },
  "$defs": {
    "positiveSafeInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
  }
}
