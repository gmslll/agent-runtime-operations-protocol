{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/common/trace.schema.json",
  "title": "AROP v1 W3C Trace Context",
  "type": "object",
  "required": ["traceparent"],
  "properties": {
    "traceparent": {
      "type": "string",
      "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "type": "string",
      "maxLength": 512
    }
  },
  "additionalProperties": false
}
