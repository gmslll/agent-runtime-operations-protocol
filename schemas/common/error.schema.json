{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/common/error.schema.json",
  "title": "AROP v1 error",
  "type": "object",
  "required": ["code", "category", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
    },
    "category": {
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "not_found",
        "conflict",
        "capacity",
        "dependency",
        "timeout",
        "cancelled",
        "protocol",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "details": {
      "type": "object"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  },
  "additionalProperties": false
}
