{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/common/identifiers.schema.json",
  "title": "AROP v1 identifiers",
  "$comment": "arop.invalid is a reserved provisional base URI and will be replaced before the first stable public release.",
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "agentId": {
      "$ref": "#/$defs/slug"
    },
    "skillId": {
      "$ref": "#/$defs/slug"
    },
    "serviceId": {
      "$ref": "#/$defs/slug"
    },
    "instanceId": {
      "$ref": "#/$defs/slug"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deploymentId": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lease_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^att_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "assetId": {
      "type": "string",
      "pattern": "^asset_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "conversationRef": {
      "type": "string",
      "pattern": "^conv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "effectId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200,
      "pattern": "^eff_[A-Za-z0-9._:-]+$"
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilityId": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+\\.v[1-9][0-9]*$"
    },
    "extensionId": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}\\.v[1-9][0-9]*$"
    }
  }
}
