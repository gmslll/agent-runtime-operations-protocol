{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/registry/runtime-instance-v1.schema.json",
  "title": "AROP v1 runtime instance",
  "$comment": "A registered runtime session. Instance identity is stable; session identity is fresh per process; generation and registry revision are JS-safe fencing values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance_id", "session_id", "service_id", "environment", "generation", "resource_version", "registry_revision", "lease_id", "lease_expires_at", "endpoint", "bindings", "runtime", "operator", "draining", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "instance_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/instanceId"},
    "session_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/sessionId"},
    "service_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/serviceId"},
    "environment": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/slug"},
    "generation": {"$ref": "#/$defs/positiveSafeInteger"},
    "resource_version": {"$ref": "#/$defs/positiveSafeInteger"},
    "registry_revision": {"$ref": "#/$defs/positiveSafeInteger"},
    "lease_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/leaseId"},
    "lease_expires_at": {"type": "string", "format": "date-time"},
    "endpoint": {"$ref": "#/$defs/endpoint"},
    "bindings": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/binding"}},
    "runtime": {"$ref": "#/$defs/runtime"},
    "operator": {"$ref": "#/$defs/operator"},
    "draining": {"type": "boolean"},
    "drain_deadline_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["registered", "expired", "deregistered"]}
  },
  "$defs": {
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveSafeInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "health_path"],
      "properties": {
        "base_url": {"type": "string", "format": "uri", "pattern": "^https://[^?#]+$", "maxLength": 2048},
        "health_path": {
          "type": "string",
          "pattern": "^/[^?#]*$",
          "maxLength": 512,
          "not": {"pattern": "\\.\\."}
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "agent_version", "skill_ids", "manifest_digest"],
      "properties": {
        "agent_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/agentId"},
        "agent_version": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/semanticVersion"},
        "skill_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/skillId"}},
        "manifest_digest": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/sha256Digest"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["streaming", "stream_resume", "cancellation", "status_query", "event_outbox"],
      "properties": {
        "streaming": {"type": "boolean"},
        "stream_resume": {"type": "boolean"},
        "cancellation": {"type": "boolean"},
        "status_query": {"type": "boolean"},
        "event_outbox": {"enum": ["durable", "best-effort"]}
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "max_queue_depth", "active_runs", "available_slots", "queue_depth"],
      "properties": {
        "max_concurrency": {"$ref": "#/$defs/positiveSafeInteger"},
        "max_queue_depth": {"$ref": "#/$defs/safeInteger"},
        "active_runs": {"$ref": "#/$defs/safeInteger"},
        "available_slots": {"$ref": "#/$defs/safeInteger"},
        "queue_depth": {"$ref": "#/$defs/safeInteger"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "ready", "runtime_version", "protocol_versions", "transport_profiles", "capabilities", "capacity", "labels"],
      "properties": {
        "healthy": {"type": "boolean"},
        "ready": {"type": "boolean"},
        "runtime_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "protocol_versions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "transport_profiles": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "capabilities": {"$ref": "#/$defs/capabilities"},
        "capacity": {"$ref": "#/$defs/capacity"},
        "labels": {"type": "object", "maxProperties": 128, "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 64}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "weight", "priority"],
      "properties": {
        "enabled": {"type": "boolean"},
        "weight": {"type": "integer", "minimum": 0, "maximum": 1000},
        "priority": {"$ref": "#/$defs/safeInteger"},
        "maintenance_reason": {"type": "string", "maxLength": 512}
      }
    }
  }
}
