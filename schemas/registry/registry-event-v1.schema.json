{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/registry/registry-event-v1.schema.json",
  "title": "AROP v1 registry event",
  "$comment": "Registry events are append-only and globally ordered by a JS-safe revision. P14 never deletes events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "revision", "type", "instance_id", "session_id", "generation", "occurred_at"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/eventId"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "type": {"enum": ["registered", "keepalive", "updated", "draining", "deregistered", "expired"]},
    "instance_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/instanceId"},
    "session_id": {"$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/sessionId"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
