{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/resources/secret-ref-v1.schema.json",
  "title": "AROP v1 SecretRef declaration",
  "type": "object",
  "required": ["name", "purpose"],
  "properties": {
    "name": {
      "$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/slug"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "allowed_operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/slug"
      }
    }
  },
  "additionalProperties": false
}
