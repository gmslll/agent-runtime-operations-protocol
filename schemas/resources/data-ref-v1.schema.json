{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arop.invalid/schemas/v1/resources/data-ref-v1.schema.json",
  "title": "AROP v1 DataRef",
  "type": "object",
  "required": ["data_id", "resource_type", "selector", "actions"],
  "properties": {
    "data_id": {
      "type": "string",
      "pattern": "^data_[A-Za-z0-9._:-]+$",
      "maxLength": 200
    },
    "resource_type": {
      "$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/slug"
    },
    "selector": {
      "type": "object",
      "minProperties": 1
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://arop.invalid/schemas/v1/common/identifiers.schema.json#/$defs/slug"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
